---
import "@fontsource-variable/inter"
import "@fontsource-variable/jetbrains-mono"
import "../styles/tokens.css"
import "../styles/dock.css"
import "../styles/landing.css"
import AiDisclaimer from "../components/AiDisclaimer.astro"
import Dock from "../components/dock/Dock.astro"
import Footer from "../components/landing/Footer.astro"
import Closing from "../components/landing/Closing.astro"
import Compare from "../components/landing/Compare.astro"
import Developers from "../components/landing/Developers.astro"
import Features from "../components/landing/Features.astro"
import Bar from "../components/landing/Bar.astro"
import Hero from "../components/landing/Hero.astro"
import More from "../components/landing/More.astro"
import Operate from "../components/landing/Operate.astro"
import Recordings from "../components/landing/Recordings.astro"
import Repos from "../components/landing/Repos.astro"
import Sources from "../components/landing/Sources.astro"
import Start from "../components/landing/Start.astro"
import Stats from "../components/landing/Stats.astro"
import Ticker from "../components/landing/Ticker.astro"
import { localized as url } from "../topics.mjs"

const title = "Holtdroid — give your testers a cozy holt"
const description =
  "Self-hosted Android devices in a browser tab for testing APKs: the screen, WebView DevTools, a VPN location per device and recordings."
const image = "https://github.com/holtdroid/.github/raw/main/profile/assets/social-holtdroid.png"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      ;(() => {
        document.documentElement.classList.add("js")
        let theme = null
        try {
          theme = localStorage.getItem("starlight-theme")
        } catch {}
        document.documentElement.dataset.theme =
          theme === "light" || theme === "dark"
            ? theme
            : matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark"
      })()
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="canonical" href={new URL(url("/"), Astro.site)} />
    <meta name="theme-color" content="#f2f2f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="l-page">
    <Bar />
    <main>
      <Hero />
      <Ticker />
      <Stats />
      <Features />
      <Recordings />
      <Sources />
      <More />
      <Compare />
      <Developers />
      <Operate />
      <Start />
      <Repos />
      <Closing />
      <section class="l-wrap l-disclaimer">
        <AiDisclaimer />
      </section>
    </main>
    <Footer />
    <Dock active="home" />
    <script is:inline>
      ;(() => {
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
        const count = (root) => {
          for (const el of root.querySelectorAll("[data-count]")) {
            const target = Number(el.dataset.count)
            if (reduce || !target) continue
            const start = performance.now()
            const step = (now) => {
              const t = Math.min(1, (now - start) / 900)
              el.textContent = String(Math.round(target * (1 - (1 - t) ** 3)))
              if (t < 1) requestAnimationFrame(step)
            }
            el.textContent = "0"
            requestAnimationFrame(step)
          }
        }
        const reveal = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue
              e.target.classList.add("is-in")
              count(e.target)
              reveal.unobserve(e.target)
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
        )
        for (const el of document.querySelectorAll("[data-reveal]")) reveal.observe(el)
        const live = new IntersectionObserver((entries) => {
          for (const e of entries) e.target.classList.toggle("is-live", e.isIntersecting)
        })
        for (const el of document.querySelectorAll("[data-live]")) live.observe(el)
        if (reduce) return
        const next = { free: "booting", booting: "ready", ready: "free" }
        for (const node of document.querySelectorAll("[data-node]")) {
          const slots = [...node.querySelectorAll("[data-s]")]
          let k = 0
          setInterval(() => {
            if (!node.classList.contains("is-live") || document.hidden) return
            const slot = slots[k++ % slots.length]
            slot.dataset.s = next[slot.dataset.s] ?? "free"
            slot.textContent = slot.dataset.s
          }, 3000)
        }
      })()
    </script>
  </body>
</html>
