---
const required = [
  "I take these risks on myself. Nobody talked me into anything: I decide what happens to my device, and I own the outcome.",
  "This can break the device for good: a brick that never boots again, every byte of data gone, no way back.",
  "Nobody is responsible for what happens, not the author of this site, not the Holtdroid project, not the authors of the tools mentioned here.",
  "This may violate the terms of use of my device, of its vendor's services, of my carrier, and the rules of my employer or organisation.",
  "It limits the device irreversibly: on Samsung the Knox fuse blows once and forever, taking Samsung Pay, Secure Folder, every Knox-backed feature and the warranty with it, even after going back to stock.",
  "I am reading this for educational purposes only. I am not planning to root or reflash my device, or anyone else's.",
]
---

<div class="risk-gate not-content" data-risk-gate>
  <form class="gate" onsubmit="return false">
    <p class="lead">
      This page is blurred on purpose. It describes how a test phone was unlocked and rooted, step by step, with the
      sites and repositories that were used. Before it unblurs, tick every statement below. All of them, honestly.
    </p>
    <ul class="terms">
      {
        required.map((text) => (
          <li>
            <label>
              <input type="checkbox" data-required />
              <span>{text}</span>
            </label>
          </li>
        ))
      }
      <li class="cactus-row" data-cactus-row>
        <label>
          <input type="checkbox" data-cactus />
          <span>I am a cactus. 🌵</span>
        </label>
      </li>
    </ul>
    <div class="actions">
      <span class="button-wrap" data-button-wrap>
        <button type="button" disabled data-reveal>Show the guide</button>
        <span class="tip" role="tooltip">
          Absolutely not. This project is firmly, openly and irreversibly anti-cactus. Cacti are not allowed to root
          anything. Untick that box, or go photosynthesise somewhere else.
        </span>
      </span>
      <span class="hint" data-hint aria-live="polite">Tick every statement to continue.</span>
    </div>
  </form>
  <div class="content" data-content aria-hidden="true" inert>
    <slot />
  </div>
</div>

<script>
  function arm(root: HTMLElement) {
    const required = [...root.querySelectorAll<HTMLInputElement>("[data-required]")]
    const cactus = root.querySelector<HTMLInputElement>("[data-cactus]")!
    const cactusRow = root.querySelector<HTMLElement>("[data-cactus-row]")!
    const wrap = root.querySelector<HTMLElement>("[data-button-wrap]")!
    const button = root.querySelector<HTMLButtonElement>("[data-reveal]")!
    const hint = root.querySelector<HTMLElement>("[data-hint]")!
    const content = root.querySelector<HTMLElement>("[data-content]")!

    const update = () => {
      const all = required.every((i) => i.checked)
      const isCactus = cactus.checked
      cactusRow.classList.toggle("lit", isCactus)
      wrap.classList.toggle("cactus", isCactus)
      button.disabled = isCactus || !all
      hint.textContent = isCactus
        ? "A cactus has been detected. The button has been withdrawn."
        : all
          ? "Thank you. The guide is yours."
          : `${required.filter((i) => i.checked).length} of ${required.length} ticked.`
    }

    for (const input of [...required, cactus]) input.addEventListener("change", update)
    button.addEventListener("click", () => {
      if (button.disabled) return
      root.classList.add("open")
      content.removeAttribute("aria-hidden")
      content.removeAttribute("inert")
      for (const input of [...required, cactus]) input.disabled = true
      button.disabled = true
      hint.textContent = "Unblurred. Read it, and then do nothing with it."
    })
    update()
  }

  document.querySelectorAll<HTMLElement>("[data-risk-gate]").forEach(arm)
</script>

<style is:global>
  .risk-gate .gate {
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--sl-color-orange);
    border-radius: 0.6rem;
    background: var(--sl-color-orange-low);
    color: var(--sl-color-white);
  }
  .risk-gate .lead {
    margin: 0 0 1rem;
    font-weight: 600;
  }
  .risk-gate .terms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .risk-gate .terms label {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.6rem;
    align-items: start;
    padding: 0.5rem 0.6rem;
    border-radius: 0.4rem;
    cursor: pointer;
    line-height: 1.45;
  }
  .risk-gate .terms label:hover {
    background: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
  }
  .risk-gate .terms input {
    margin: 0.25rem 0 0;
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--sl-color-orange);
  }
  .risk-gate .cactus-row {
    margin-top: 0.5rem;
    border-top: 1px dashed var(--sl-color-gray-4);
    padding-top: 0.6rem;
  }
  .risk-gate .cactus-row label {
    font-style: italic;
    color: var(--sl-color-gray-2);
  }
  .risk-gate .cactus-row.lit label {
    background: color-mix(in srgb, var(--sl-color-green) 22%, transparent);
    box-shadow: 0 0 0 2px var(--sl-color-green);
    color: var(--sl-color-white);
    font-style: normal;
    font-weight: 600;
  }
  .risk-gate .cactus-row.lit input {
    accent-color: var(--sl-color-green);
  }
  .risk-gate .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.1rem;
  }
  .risk-gate .button-wrap {
    position: relative;
    display: inline-block;
  }
  .risk-gate button {
    font: inherit;
    font-weight: 600;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 0;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    cursor: pointer;
  }
  .risk-gate button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  .risk-gate .button-wrap.cactus button:disabled {
    background: var(--sl-color-green);
    opacity: 0.6;
    cursor: not-allowed;
  }
  .risk-gate .tip {
    display: none;
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.6rem);
    width: min(22rem, 80vw);
    padding: 0.6rem 0.8rem;
    border-radius: 0.5rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-green);
    font-size: var(--sl-text-sm);
    line-height: 1.4;
    z-index: 2;
  }
  .risk-gate .tip::after {
    content: "";
    position: absolute;
    left: 1.2rem;
    top: 100%;
    border: 0.45rem solid transparent;
    border-top-color: var(--sl-color-green);
  }
  .risk-gate .button-wrap.cactus:hover .tip,
  .risk-gate .button-wrap.cactus:focus-within .tip {
    display: block;
  }
  .risk-gate .hint {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .risk-gate .content {
    filter: blur(9px);
    user-select: none;
    pointer-events: none;
    transition: filter 0.4s ease;
  }
  .risk-gate.open .content {
    filter: none;
    user-select: auto;
    pointer-events: auto;
  }
  .risk-gate.open .gate {
    opacity: 0.7;
  }
</style>
