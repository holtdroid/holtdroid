---
// The checklist that unblurs the rooting guide. One of the items is a trap
// ("I am a cactus"): it looks like every other line, and only when someone
// hits the reveal button with it ticked does it light up and refuse.
const items = [
  { text: "I take these risks on myself. Nobody talked me into anything: I decide what happens to my device, and I own the outcome." },
  { text: "This can break the device for good: a brick that never boots again, every byte of data gone, no way back." },
  { text: "Nobody is responsible for what happens, not the author of this site, not the Holtdroid project, not the authors of the tools mentioned here." },
  { text: "I am a cactus. 🌵", cactus: true },
  { text: "This may violate the terms of use of my device, of its vendor's services, of my carrier, and the rules of my employer or organisation." },
  { text: "It limits the device irreversibly: on Samsung the Knox fuse blows once and forever, taking Samsung Pay, Secure Folder, every Knox-backed feature and the warranty with it, even after going back to stock." },
  { text: "I am reading this for educational purposes only. I am not planning to root or reflash my device, or anyone else's." },
]
---

<div class="risk-gate not-content" data-risk-gate>
  <form class="gate" data-gate onsubmit="return false">
    <p class="lead">
      This page is blurred on purpose. It describes how a test phone was unlocked and rooted, step by step, with the
      sites and repositories that were used. Before it unblurs, tick every statement below. All of them, honestly.
    </p>
    <ul class="terms">
      {
        items.map((item) => (
          <li class:list={["term", { cactus: item.cactus }]} data-cactus={item.cactus ? "" : null}>
            <label>
              <input type="checkbox" data-input data-cactus-input={item.cactus ? "" : null} />
              <span>{item.text}</span>
            </label>
          </li>
        ))
      }
    </ul>
    <div class="actions">
      <button type="button" disabled data-reveal>Show the guide</button>
      <span class="hint" data-hint aria-live="polite">Tick every statement to continue.</span>
    </div>
  </form>

  <aside class="disclaimer" data-disclaimer hidden>
    <strong>At your own risk.</strong> Everything on this page is done by you, on your own responsibility. The outcome
    is yours, not the maintainer's, not the Holtdroid project's, not the authors' of the tools named here.
  </aside>

  <div class="content" data-content aria-hidden="true" inert>
    <slot />
  </div>
</div>

<script>
  function arm(root: HTMLElement) {
    const inputs = [...root.querySelectorAll<HTMLInputElement>("[data-input]")]
    const cactusRow = root.querySelector<HTMLElement>("[data-cactus]")
    const cactusInput = root.querySelector<HTMLInputElement>("[data-cactus-input]")
    const normal = inputs.filter((i) => i !== cactusInput)
    const button = root.querySelector<HTMLButtonElement>("[data-reveal]")!
    const hint = root.querySelector<HTMLElement>("[data-hint]")!
    const gate = root.querySelector<HTMLElement>("[data-gate]")!
    const disclaimer = root.querySelector<HTMLElement>("[data-disclaimer]")!
    const content = root.querySelector<HTMLElement>("[data-content]")!

    const allTicked = () => normal.every((i) => i.checked)
    const update = () => {
      cactusRow?.classList.remove("lit")
      button.disabled = !allTicked()
      hint.textContent = allTicked()
        ? "Ready. Press the button."
        : `${normal.filter((i) => i.checked).length} of ${normal.length} ticked.`
    }

    for (const input of inputs) input.addEventListener("change", update)

    button.addEventListener("click", () => {
      if (button.disabled) return
      if (cactusInput?.checked) {
        cactusRow?.classList.add("lit")
        hint.textContent =
          "A cactus. This project is firmly, openly and irreversibly anti-cactus — cacti may not root anything. Untick that, or go photosynthesise elsewhere."
        cactusRow?.scrollIntoView({ block: "center", behavior: "smooth" })
        return
      }
      root.classList.add("open")
      gate.hidden = true
      disclaimer.hidden = false
      content.removeAttribute("aria-hidden")
      content.removeAttribute("inert")
    })

    update()
  }

  document.querySelectorAll<HTMLElement>("[data-risk-gate]").forEach(arm)
</script>

<style is:global>
  .risk-gate .gate {
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--sl-color-orange);
    border-radius: 0.6rem;
    background: var(--sl-color-orange-low);
    color: var(--sl-color-white);
  }
  .risk-gate .lead {
    margin: 0 0 1rem;
    font-weight: 600;
  }
  .risk-gate .terms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .risk-gate .term label {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.6rem;
    align-items: start;
    padding: 0.5rem 0.6rem;
    border-radius: 0.4rem;
    cursor: pointer;
    line-height: 1.45;
  }
  .risk-gate .term label:hover {
    background: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
  }
  .risk-gate .term input {
    margin: 0.25rem 0 0;
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--sl-color-orange);
  }
  .risk-gate .term.lit label {
    background: color-mix(in srgb, var(--sl-color-green) 22%, transparent);
    box-shadow: 0 0 0 2px var(--sl-color-green);
    color: var(--sl-color-white);
    font-weight: 600;
    animation: risk-gate-pop 0.3s ease;
  }
  .risk-gate .term.lit input {
    accent-color: var(--sl-color-green);
  }
  @keyframes risk-gate-pop {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.02);
    }
    100% {
      transform: scale(1);
    }
  }
  .risk-gate .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.1rem;
  }
  .risk-gate button {
    font: inherit;
    font-weight: 600;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 0;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    cursor: pointer;
  }
  .risk-gate button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  .risk-gate .hint {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .risk-gate .disclaimer {
    position: sticky;
    top: 0;
    z-index: 20;
    margin: 0 0 1.25rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--sl-color-orange);
    border-radius: 0.5rem;
    background: var(--sl-color-orange-low);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    line-height: 1.45;
    backdrop-filter: blur(6px);
  }
  .risk-gate .disclaimer strong {
    color: var(--sl-color-orange-high);
  }
  .risk-gate .content {
    filter: blur(9px);
    user-select: none;
    pointer-events: none;
    transition: filter 0.4s ease;
  }
  .risk-gate.open .content {
    filter: none;
    user-select: auto;
    pointer-events: auto;
  }
</style>
