---
import { Icon } from "@astrojs/starlight/components"
import Default from "@astrojs/starlight/components/Sidebar.astro"
import { localized, topics } from "../../topics.mjs"

const { locale } = Astro.locals.starlightRoute
const current = Astro.locals.starlightSidebarTopics?.topics ?? []
---

<ul class="hd-topics md:sl-hidden">
  {
    topics.map((t, i) => (
      <li>
        <a href={localized(t.link, locale)} aria-current={current[i]?.isCurrent ? "page" : undefined}>
          <Icon name={t.icon} />
          {current[i]?.label ?? t.label.en}
        </a>
      </li>
    ))
  }
</ul>
<Default><slot /></Default>
