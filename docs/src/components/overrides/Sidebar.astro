---
import { Icon } from "@astrojs/starlight/components"
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro"
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro"
import { externalLinks, localized, topics } from "../../topics.mjs"
import SidebarList from "./SidebarList.astro"

const { locale, sidebar } = Astro.locals.starlightRoute
const current = Astro.locals.starlightSidebarTopics?.topics ?? []
const active = current.findIndex((t) => t.isCurrent)
const topic = active >= 0 ? topics[active] : undefined
---

<ul class="hd-topics">
  {
    topics.map((t, i) => (
      <li>
        <a href={localized(t.link, t.link.startsWith("/guides/") ? locale : undefined)} aria-current={current[i]?.isCurrent ? "page" : undefined}>
          <span class="hd-topic-icon">
            <Icon name={t.icon} />
          </span>
          {current[i]?.label ?? t.label.en}
        </a>
      </li>
    ))
  }
  {
    externalLinks.map((l) => (
      <li>
        <a href={l.href} rel="noopener">
          <span class="hd-topic-icon">
            <Icon name={l.icon} />
          </span>
          {l.label}
        </a>
      </li>
    ))
  }
</ul>

{topic && <p class="hd-nav-title">{current[active]?.label}</p>}

<SidebarPersister>
  <SidebarList entries={sidebar} icons={topic?.groupIcons} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
