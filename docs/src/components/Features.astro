---
import { Icon } from "@astrojs/starlight/components"

type IconName = Parameters<typeof Icon>[0]["name"]

const features: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "approve-check",
    title: "No APK patching",
    text: "WebView debugging is switched on at runtime. The APK is installed exactly as your team shipped it.",
  },
  {
    icon: "laptop",
    title: "Everything in one tab",
    text: "Screen and Chrome DevTools side by side, with a two-way clipboard. No adb or local Chrome needed.",
  },
  {
    icon: "rocket",
    title: "ARM APKs on x86 nodes",
    text: "Android in containers on the node's kernel, several per node, with ARM translation for ARM-only builds.",
  },
  {
    icon: "random",
    title: "Per-session VPN",
    text: "Each device gets its own egress. Switch the country next to the device without restarting anything.",
  },
  {
    icon: "seti:clock",
    title: "Sessions that clean up",
    text: "Bounded slots, idle timeout and max TTL. See who is using what, extend with one click.",
  },
  {
    icon: "puzzle",
    title: "Pluggable by contract",
    text: "Sources, device providers, VPN, secrets and sign-in are swappable. Real USB phones work too, without root.",
  },
]
---

<ul class="hd-features not-content">
  {
    features.map((f, i) => (
      <li class="hd-panel" style={`--i: ${i}`}>
        <span class="hd-tile">
          <Icon name={f.icon} size="1.25rem" />
        </span>
        <div>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .hd-features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hd-features li {
    display: flex;
    gap: 0.9rem;
    margin: 0;
    padding: 1.1rem;
  }
  .hd-features h3 {
    margin: 0 0 0.25rem;
    font-size: var(--sl-text-base);
  }
  .hd-features p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }
</style>
