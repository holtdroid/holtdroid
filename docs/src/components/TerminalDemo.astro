---
import overview from "../../../internal/connect/tui/testdata/overview.golden?raw"
import devices from "../../../internal/connect/tui/testdata/devices.golden?raw"
import ports from "../../../internal/connect/tui/testdata/ports.golden?raw"
import published from "../../../internal/connect/tui/testdata/ports-published.golden?raw"
import settings from "../../../internal/connect/tui/testdata/settings.golden?raw"
import installed from "../../../internal/connect/tui/testdata/settings-installed.golden?raw"

// Frames of the full-screen UI are the TUI's golden test files, so the demo
// always shows what the client really draws.
type Line = { text: string; kind?: "cmd" | "dim" }
type Step = { tab: number; caption: string; lines?: Line[]; frame?: string; pause?: number }

const portal = "https://android.example.com"
const steps: Step[] = [
  {
    tab: 0,
    caption: "Paste the command from the portal's Computers page into a terminal.",
    lines: [{ text: `curl -fsSL ${portal}/tunnel.sh | sh -s -- eyJhbGciOiJIUzI1NiIs…`, kind: "cmd" }],
  },
  {
    tab: 0,
    caption: "The script downloads the client for your system, checks it and starts it.",
    lines: [{ text: "holtdroid: next time run /Users/otter/.cache/holtdroid/holtdroid to reconnect without a new code" }],
    pause: 1200,
  },
  { tab: 0, caption: "The computer is enrolled and connected; a device you launched is already there.", frame: overview, pause: 3200 },
  {
    tab: 0,
    caption: "Devices: each one gets its own ADB port, already in adb; Enter opens it in the browser, w opens chrome://inspect.",
    frame: devices,
    pause: 3400,
  },
  { tab: 0, caption: "Ports: your dev servers, with the published ones lit up.", frame: ports, pause: 2600 },
  { tab: 0, caption: "Space publishes port 5173: every device now reaches it as localhost:5173.", frame: published, pause: 3000 },
  { tab: 0, caption: "Settings: version, where things are, and the holtdroid command.", frame: settings, pause: 2600 },
  { tab: 0, caption: "Enter installs it, so next time holtdroid alone reconnects.", frame: installed, pause: 3000 },
  {
    tab: 1,
    caption: "Meanwhile, in another terminal, adb already knows the device.",
    lines: [
      { text: "adb devices", kind: "cmd" },
      { text: "List of devices attached" },
      { text: "127.0.0.1:15555\tdevice" },
      { text: "" },
      { text: "adb -s 127.0.0.1:15555 shell getprop ro.product.model", kind: "cmd" },
      { text: "sdk_gphone64_arm64" },
    ],
    pause: 3600,
  },
]
const tabs = ["holtdroid", "zsh"]
const last = (i: number) => {
  const mine = steps.filter((s) => s.tab === i)
  const frameAt = mine.findLastIndex((s) => s.frame)
  if (frameAt >= 0) return mine[frameAt].frame!.trimEnd().split("\n").map((text) => ({ text }))
  return mine.flatMap((s) => s.lines ?? [])
}
---

<figure class="terminal-demo not-content" data-steps={JSON.stringify(steps)}>
  <div class="window">
    <div class="bar">
      <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
      <div class="tabs">
        {tabs.map((name, i) => <span class:list={["tab", { active: i === 0 }]} data-tab={i}>{name}</span>)}
      </div>
    </div>
    {
      tabs.map((_, i) => (
        <pre class:list={["screen", { hidden: i !== 0 }]} data-screen={i} aria-hidden="true">
          {last(i).map((l: Line) => (
            <span class:list={["line", l.kind]}>{l.text || " "}</span>
          ))}
        </pre>
      ))
    }
  </div>
  <figcaption aria-live="polite">{steps[steps.length - 1]?.caption}</figcaption>
</figure>

<script>
  type Line = { text: string; kind?: string }
  type Step = { tab: number; caption: string; lines?: Line[]; frame?: string; pause?: number }

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms))

  async function play(root: HTMLElement) {
    const steps: Step[] = JSON.parse(root.dataset.steps ?? "[]")
    const screens = [...root.querySelectorAll<HTMLElement>("[data-screen]")]
    const tabs = [...root.querySelectorAll<HTMLElement>("[data-tab]")]
    const caption = root.querySelector("figcaption")!
    const show = (tab: number) => {
      screens.forEach((s, i) => s.classList.toggle("hidden", i !== tab))
      tabs.forEach((t, i) => t.classList.toggle("active", i === tab))
    }
    const add = (screen: HTMLElement, line: Line) => {
      const span = document.createElement("span")
      span.className = `line ${line.kind ?? ""}`
      span.textContent = line.kind === "cmd" ? "" : line.text || " "
      screen.append(span)
      screen.scrollTop = screen.scrollHeight
      return span
    }

    for (;;) {
      screens.forEach((s) => s.replaceChildren())
      for (const step of steps) {
        show(step.tab)
        caption.textContent = step.caption
        const screen = screens[step.tab]
        if (step.frame !== undefined) {
          screen.replaceChildren()
          for (const text of step.frame.trimEnd().split("\n")) add(screen, { text })
          screen.scrollTop = 0
        }
        for (const line of step.lines ?? []) {
          const span = add(screen, line)
          if (line.kind === "cmd") {
            await sleep(500)
            for (const ch of line.text) {
              span.textContent += ch
              await sleep(line.text.length > 60 ? 18 : 45)
            }
            await sleep(450)
          } else {
            await sleep(70)
          }
        }
        await sleep(step.pause ?? 1600)
      }
      await sleep(1500)
    }
  }

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>(".terminal-demo").forEach((root) => void play(root))
  }
</script>

<style is:global>
  .terminal-demo {
    margin: 1.5rem 0;
  }
  .terminal-demo .window {
    border-radius: 0.6rem;
    overflow: hidden;
    background: #0f1419;
    border: 1px solid #2a313a;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
  }
  .terminal-demo .bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    background: #1b2129;
    border-bottom: 1px solid #2a313a;
  }
  .terminal-demo .dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
  }
  .terminal-demo .red {
    background: #ff5f57;
  }
  .terminal-demo .yellow {
    background: #febc2e;
  }
  .terminal-demo .green {
    background: #28c840;
  }
  .terminal-demo .tabs {
    display: flex;
    gap: 0.25rem;
    margin-left: 0.75rem;
  }
  .terminal-demo .tab {
    font: 0.75rem var(--sl-font-system-mono, ui-monospace, monospace);
    color: #8b949e;
    padding: 0.15rem 0.6rem;
    border-radius: 0.35rem;
  }
  .terminal-demo .tab.active {
    color: #e6edf3;
    background: #2a313a;
  }
  .terminal-demo .screen {
    margin: 0;
    height: 22rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.85rem 1rem;
    background: transparent;
    border: 0;
    color: #e6edf3;
    font: 0.68rem/1.2 var(--sl-font-system-mono, ui-monospace, monospace);
  }
  .terminal-demo .screen.hidden {
    display: none;
  }
  .terminal-demo .line {
    display: block;
    white-space: pre;
  }
  .terminal-demo .cmd::before {
    content: "~ $ ";
    color: #3fb950;
  }
  .terminal-demo .dim {
    color: #8b949e;
  }
  .terminal-demo figcaption {
    margin-top: 0.6rem;
    min-height: 2.6em;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
</style>
