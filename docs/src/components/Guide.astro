---
import GuidePlayer from "../guides/player"
import ThemeSync from "./ThemeSync.astro"

interface Props {
  id: string
}

const locale = Astro.locals.starlightRoute.locale
const lang = locale === "ru" || locale === "uk" ? locale : "en"
---

<div class="hd-guide">
  <GuidePlayer client:only="react" guide={Astro.props.id} lang={lang} />
</div>

<ThemeSync />
