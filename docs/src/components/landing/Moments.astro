---
import Showcase from "../../guides/showcase"
import { localized as url } from "../../topics.mjs"
import DockIcon from "../dock/DockIcon.astro"
import { moments } from "./moments"
---

<section class="l-wrap l-section">
  <div class="l-head">
    <h2 class="l-title">From a build to a bug report</h2>
    <p class="l-lead l-lead-s">Three screens a tester spends the day in. Each has a guide that walks through it.</p>
  </div>
  <div class="l-moments">
    {
      moments.map((m) => (
        <article class="l-card l-moment">
          <div class="l-shot l-shot-card">
            <Showcase client:only="react" state={m.state} view={m.view} label={m.title} />
          </div>
          <div class="l-moment-body">
            <span class="l-label l-mono">{m.step}</span>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
            <a class="hd-btn hd-btn-s" href={url(m.href)}>
              Guide
              <DockIcon name="arrow" />
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
