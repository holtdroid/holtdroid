---
import logo from "../../assets/logo.svg"
import Showcase from "../../guides/showcase"
import { localized as url } from "../../topics.mjs"
import DockIcon from "../dock/DockIcon.astro"
import { hero } from "./moments"
---

<header class="l-wrap l-brand">
  <a class="l-brand-name" href={url("/")}>
    <img src={logo.src} alt="" width="32" height="32" />
    holtdroid
  </a>
  <span class="l-grow"></span>
  <span class="hd-badge l-mono">Apache-2.0</span>
  <a class="hd-btn" href="https://github.com/holtdroid/holtdroid">
    <DockIcon name="git" />
    GitHub
  </a>
</header>

<section class="l-wrap l-hero">
  <span class="hd-badge l-pill"><span class="l-dot"></span>Self-hosted Android devices for testers</span>
  <h1 class="l-big">Give your testers <br /><span class="l-mu">a cozy holt.</span></h1>
  <p class="l-lead">
    Android devices in a browser tab: the screen, Chrome DevTools for every WebView, a VPN location per device and
    recordings with network and logcat. Builds arrive from Slack, S3 or GitHub.
  </p>
  <div class="l-actions">
    <a class="hd-btn hd-btn-p hd-btn-l" href={url("/start/installation/")}>
      Get started
      <DockIcon name="arrow" />
    </a>
    <a class="hd-btn hd-btn-l" href={url("/guides/first-steps/launch-app/")}>
      <DockIcon name="play" />
      Interactive tour
    </a>
  </div>
</section>

<section class="l-wrap l-hero-shot">
  <div class="l-shot l-shot-hero">
    <Showcase client:only="react" state={hero.state} view={hero.view} label="The session page of the portal" />
  </div>
  <p class="l-caption">The session page, drawn with the portal's own components</p>
</section>
