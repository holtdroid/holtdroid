---
import { localized as url } from "../../topics.mjs"
import DockIcon from "../dock/DockIcon.astro"
import { hero } from "./features"
import Scene from "./Scene"

const trust = ["Apache-2.0", "One Helm chart", "Android 11–16", "APK never modified"]
---

<section class="l-wrap l-hero">
  <span class="hd-badge l-pill l-rise"><span class="l-dot"></span>Self-hosted Android devices for testers</span>
  <h1 class="l-big">
    <span class="l-rise">Give your testers</span>
    <span class="l-rise l-mu">a cozy holt.</span>
  </h1>
  <p class="l-lead l-rise">
    Self-hosted, open-source Android devices in a browser tab: the screen, Chrome DevTools for every WebView, a VPN location per device and
    recordings with network and logcat. Builds arrive from Slack, S3 or GitHub.
  </p>
  <div class="l-actions l-rise">
    <a class="hd-btn hd-btn-p hd-btn-l" href={url("/start/installation/")}>
      Get started
      <DockIcon name="arrow" />
    </a>
    <a class="hd-btn hd-btn-l" href={url("/guides/first-steps/session-tour/")}>
      <DockIcon name="play" />
      Interactive tour
    </a>
  </div>
  <p class="l-trust l-mono l-rise">
    {trust.join(" · ")}
  </p>
</section>

<section class="l-wrap l-hero-shot">
  <div class="l-glow" aria-hidden="true"></div>
  <div class="l-stage l-rise">
    <Scene
      client:only="react"
      frames={hero.frames}
      still={hero.frames.length - 1}
      narrowView={hero.narrow}
      label="A device being configured, booted and debugged in the portal"
      rail
      cumulative
      frame="l-shot-hero l-tilt"
    />
    <noscript><p class="l-noscript">A device being configured, booted and debugged in the portal</p></noscript>
  </div>
  <p class="l-caption">Drawn live with the portal's own components, not a screenshot.</p>
</section>
