---
import { localized as url } from "../../topics.mjs"
import DockIcon from "../dock/DockIcon.astro"

const cards = [
  {
    title: "On Docker",
    badge: "Soon",
    text: "Docker Compose on Windows, macOS and Linux is on the way. Until then, try the UI with simulated devices.",
    code: "git clone https://github.com/holtdroid/holtdroid\ncd holtdroid && mise install && make dev",
    comment: "# :8080",
    link: { label: "Local development", href: "/start/local-development/" },
  },
  {
    title: "On Kubernetes",
    badge: "Helm",
    text: "Nodes with binder run Android in containers, several per node. x86_64 nodes for now, arm64 soon.",
    code: "helm install holtdroid \\\n  oci://ghcr.io/holtdroid/charts/holtdroid \\\n  -n holtdroid -f values.yaml",
    comment: "",
    link: { label: "Installation", href: "/start/installation/" },
  },
]
---

<section class="l-wrap l-section" id="start">
  <div class="l-head">
    <p class="l-eyebrow">Get started</p>
    <h2 class="l-title">Try it locally or install it</h2>
    <p class="l-note l-mono">No cluster? <code>make dev</code> runs the whole UI with simulated devices that stream a recorded screen.</p>
  </div>
  <div class="l-start">
    {
      cards.map((c, i) => (
        <div class="l-card l-start-card" data-reveal style={`--i:${i}`}>
          <div class="l-start-head">
            <span class="l-strong">{c.title}</span>
            <span class="hd-badge">{c.badge}</span>
          </div>
          <p class="l-label l-start-text">{c.text}</p>
          <div class="l-code">
            <div class="l-code-head">
              <span class="l-mono">shell</span>
              <button class="hd-btn hd-btn-s l-copy" type="button" data-copy={c.code} aria-label="Copy">
                <span class="l-copy-icons" aria-hidden="true">
                  <DockIcon name="copy" class="l-copy-idle" />
                  <DockIcon name="check" class="l-copy-done" />
                </span>
                <span class="l-copy-label" aria-hidden="true">
                  <span class="l-copy-idle">Copy</span>
                  <span class="l-copy-done">Copied</span>
                </span>
              </button>
              <span class="l-sr" role="status" />
            </div>
            <pre>{c.code}{c.comment && <span class="l-mu">{`   ${c.comment}`}</span>}</pre>
          </div>
          <a class="hd-btn" href={url(c.link.href)}>
            {c.link.label}
          </a>
        </div>
      ))
    }
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "")
        const status = button.nextElementSibling
        button.dataset.copied = ""
        if (status) status.textContent = "Copied"
        setTimeout(() => {
          delete button.dataset.copied
          if (status) status.textContent = ""
        }, 1500)
      } catch {}
    })
  }
</script>
