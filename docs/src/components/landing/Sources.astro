---
import { localized as url } from "../../topics.mjs"
import DockIcon from "../dock/DockIcon.astro"
import type { IconName } from "../dock/icons"

const sources: { icon: IconName; title: string; text: string; badge: string; href: string }[] = [
  {
    icon: "message",
    title: "Slack channels",
    text: "A sync job copies every APK posted in a channel, with its message as the changelog.",
    badge: "holtdroid-sync",
    href: "/sources/slack/",
  },
  {
    icon: "bucket",
    title: "S3 buckets",
    text: "CI writes builds to a bucket, the sync job copies the new ones.",
    badge: "holtdroid-sync",
    href: "/sources/s3/",
  },
  {
    icon: "git",
    title: "GitHub releases",
    text: "The APK assets of a repository's newest releases.",
    badge: "holtdroid-sync",
    href: "/sources/github/",
  },
  {
    icon: "chrome",
    title: "Chromium builds",
    text: "WebView versions from every channel, to install at launch.",
    badge: "chromium-builds",
    href: "/sources/chromium/",
  },
  {
    icon: "globe",
    title: "Release archives",
    text: "Opera, Firefox and other browsers from the public archives their makers publish.",
    badge: "holtdroid-sync",
    href: "/sources/archives/",
  },
  {
    icon: "upload",
    title: "Upload",
    text: "Drop an APK on the Apps page, with a note and only for you if you like.",
    badge: "Portal",
    href: "/sources/overview/",
  },
]
const origins: { icon: IconName; name: string; app: string; builds: string[] }[] = [
  { icon: "message", name: "Slack", app: "Pinecone Shop", builds: ["2.5.0-rc1", "2.4.0", "2.3.1"] },
  { icon: "bucket", name: "S3", app: "Otter Pay", builds: ["1.18.0-412", "1.17.2", "1.17.1"] },
  { icon: "git", name: "GitHub", app: "WebView Browser", builds: ["0.9.0", "0.8.2", "0.8.1"] },
  { icon: "globe", name: "Opera", app: "Opera", builds: ["95.1.4917", "95.0.4900", "94.2.4851"] },
]
---

<section class="l-wrap l-section l-sources" id="sources">
  <div class="l-split-copy" data-reveal>
    <p class="l-eyebrow">Sources</p>
    <h2 class="l-title">Where builds come from</h2>
    <p class="l-lead l-lead-s">
      A sync job copies new APKs from a Slack channel, an S3 bucket, GitHub releases or a vendor's release archive into a source. Testers see them on
      the Apps page a few seconds later.
    </p>
    <a class="hd-btn" href={url("/sources/overview/")}>APK sources</a>
  </div>
  <div class="l-flow" data-live aria-hidden="true" data-reveal style="--i:1">
    <div class="l-flow-from">
      {
        origins.map((o) => (
          <span class="l-flow-src">
            <DockIcon name={o.icon} />
            {o.name}
          </span>
        ))
      }
    </div>
    <svg class="l-flow-lines" viewBox="0 0 100 120" preserveAspectRatio="none">
      <path d="M0 15 L100 60" />
      <path d="M0 45 L100 60" />
      <path d="M0 75 L100 60" />
      <path d="M0 105 L100 60" />
    </svg>
    <div class="l-flow-stack">
      {
        origins.map((o) => (
          <div class="l-flow-apps">
            <span class="l-flow-title">{o.app}</span>
            {o.builds.map((b, i) => (
              <span class="l-flow-row l-mono">
                {i === 0 && <span class="l-flow-flash" />}
                {b}
                {i === 0 && <span class="l-flow-badge">new</span>}
              </span>
            ))}
          </div>
        ))
      }
    </div>
    <span class="l-flow-runner">
      <span class="l-flow-apk l-mono">.apk</span>
    </span>
  </div>
  <div class="l-card l-rows l-sources-rows">
    {
      sources.map((s, i) => (
        <a class="l-row" href={url(s.href)} data-reveal style={`--i:${i}`}>
          <span class="l-row-icon">
            <DockIcon name={s.icon} />
          </span>
          <span class="l-row-text">
            <span class="l-row-title">{s.title}</span>
            <span class="l-label">{s.text}</span>
          </span>
          <span class="hd-badge l-mono">{s.badge}</span>
        </a>
      ))
    }
  </div>
</section>
