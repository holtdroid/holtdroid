---
import logo from "../../assets/logo.svg"
import { localized as url } from "../../topics.mjs"

const guide = "/guides/first-steps/launch-app/"
const links = [
  ["Roadmap", "https://github.com/holtdroid/holtdroid/blob/main/design/roadmap.md"],
  ["Decisions", "https://github.com/holtdroid/holtdroid/blob/main/design/decisions.md"],
  ["License", "https://github.com/holtdroid/holtdroid/blob/main/LICENSE"],
]
---

<footer class="l-wrap l-footer">
  <img src={logo.src} alt="" width="28" height="28" />
  <span class="l-label">A cozy holt for your test Androids. Self-hosted, open source, Apache-2.0.</span>
  <span class="l-grow"></span>
  <nav class="l-footer-links" aria-label="Project">
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
  <nav class="l-footer-links" aria-label="Guides in your language">
    <a href={url(guide)} hreflang="en">English</a>
    <a href={url(guide, "ru")} hreflang="ru">Русский</a>
    <a href={url(guide, "uk")} hreflang="uk">Українська</a>
  </nav>
</footer>
